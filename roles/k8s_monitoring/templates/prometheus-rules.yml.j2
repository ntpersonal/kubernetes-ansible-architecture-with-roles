---
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-rules
  namespace: monitoring
data:
  alert-rules.yml: |
    groups:
    
name: cluster_alerts
    interval: 30s
    rules:# ALERT CASE 1: High CPU Usage
alert: HighCPUUsage
    expr: 100 - (avg by (instance) (irate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
    for: 2m
    labels:
      severity: warning
    annotations:
      summary: "High CPU usage on {{ '{{' }} $labels.instance {{ '}}' }}"
      description: "CPU usage is above 80% for more than 2 minutes (current value: {{ '{{' }} $value {{ '}}' }}%)"
  # ALERT CASE 2: Pod Not Running
alert: PodNotRunning
  expr: kube_pod_status_phase{phase!="Running",phase!="Succeeded"} > 0
  for: 5m
  labels:
    severity: critical
  annotations:
    summary: "Pod {{ '{{' }} $labels.namespace {{ '}}' }}/{{ '{{' }} $labels.pod {{ '}}' }} is not running"
    description: "Pod has been in {{ '{{' }} $labels.phase {{ '}}' }} state for more than 5 minutes",
,
,
