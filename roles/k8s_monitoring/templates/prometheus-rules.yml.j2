---
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-rules
  namespace: monitoring
data:
  alert-rules.yml: |
    groups:
    - name: cluster_alerts
      interval: 30s
      rules:
      - alert: HighCPUUsage
        expr: 100 - (avg by (instance) (irate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "CPU above 80% for 2+ minutes (current: {{ '{{' }} $value {{ '}}' }}%)"

      - alert: PodNotRunning
        expr: kube_pod_status_phase{phase!="Running",phase!="Succeeded"} > 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Pod {{ '{{' }} $labels.namespace {{ '}}' }}/{{ '{{' }} $labels.pod {{ '}}' }} not running"
          description: "Pod in {{ '{{' }} $labels.phase {{ '}}' }} state for 5+ minutes"
